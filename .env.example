# ── Base de données ───────────────────────────────────────────────
# SQLite (développement) :
DATABASE_URL="file:./dev.db"
# PostgreSQL (production) : changer aussi `provider` dans prisma/schema.prisma
# DATABASE_URL="postgresql://user:pass@localhost:5432/signalement_it"

# ── URL publique (QR codes, liens de suivi) ────────────────────────
NEXT_PUBLIC_BASE_URL="https://signalement.exemple.fr"

# ── Notifications service IT ───────────────────────────────────────
# Email SMTP (laisser vide pour désactiver l'envoi d'emails)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="signalement-it@exemple.fr"
IT_SUPPORT_EMAIL="support-it@exemple.fr"
# Notifier par email à partir de cette criticité : MINEUR | GENANT | BLOQUANT | AUCUNE
EMAIL_MIN_CRITICITE="GENANT"

# Webhook Teams / Slack (format incoming webhook)
WEBHOOK_URL=""
# Notifier par webhook à partir de cette criticité
WEBHOOK_MIN_CRITICITE="MINEUR"

# ── RGPD ───────────────────────────────────────────────────────────
# Purge automatique des tickets et photos après N mois
RETENTION_MONTHS="12"

# ── Sécurité (généré si absent ; utilisé pour signer certains liens) ─
APP_SECRET="changez-moi-en-production"
